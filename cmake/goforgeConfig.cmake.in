@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(gorun CONFIG REQUIRED)
find_dependency(nlohmann_json CONFIG REQUIRED)
if(@GOFORGE_ENABLE_SQLITE@)
    find_dependency(SQLite3 REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/goforgeTargets.cmake")
check_required_components(goforge)
